msgid ""
"SSH Port Forwarding: complete management for local, remote, and dynamic "
"forwarding rules running on dedicated background channels"
msgstr ""

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:51
msgid ""
"Bitwarden config sync: encrypted backup and restoration of connections and "
"keychains using Bitwarden Secure Notes"
msgstr ""

