msgid ""
"Tab context menu: added duplicate tab action and multiple layout styling "
"alignments (Host, Keychain, Port Forwarding)"
msgstr ""

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:54
msgid ""
"CJK support: bundled fallback fonts and enabled wide-character terminal "
"rendering under Flatpak"
msgstr ""

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:55
msgid ""
"Platform: improved multi-arch ARM64 building compatibility and fixed Vte "
"GObject namespace resolution"
msgstr ""

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:62
msgid ""
"SFTP rewrite: clean concurrency model with separate metadata lock and "
"transfer semaphore"
msgstr ""

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:63
msgid ""
"SFTP edit workflow: rclone copyto downloads file to /tmp for external "
"editor, monitors changes and syncs back"
msgstr ""

