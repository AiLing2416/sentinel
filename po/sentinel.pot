msgid ""
"Rclone: read-write FUSE mount, stderr-based readiness detection, atomic "
"tmpdir cleanup"
msgstr ""

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:65
msgid ""
"Rclone: implemented cross-host transfer and GLib cache dir for Flatpak "
"compatibility"
msgstr ""

