#: data/io.github.ailing2416.sentinel.desktop.in:3
#: data/io.github.ailing2416.sentinel.metainfo.xml.in:7
msgid "Secure GNOME SSH connection manager"
msgstr "Secure GNOME SSH connection manager"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:9
msgid "Sentinel is a native GNOME SSH connection manager focused on security and aesthetics. It integrates with password managers like Bitwarden to keep your credentials safe."
msgstr "Sentinel is a native GNOME SSH connection manager focused on security and aesthetics. It integrates with password managers like Bitwarden to keep your credentials safe."

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:14
msgid "Native libadwaita UI"
msgstr "Native libadwaita UI"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:15
msgid "Bitwarden vault integration"
msgstr "Bitwarden vault integration"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:16
msgid "Secure memory handling for credentials"
msgstr "Secure memory handling for credentials"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:17
msgid "Integrated VTE terminal with multi-tab support"
msgstr "Integrated VTE terminal with multi-tab support"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:18
msgid "SFTP file browser with drag-and-drop"
msgstr "SFTP file browser with drag-and-drop"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:24
msgid "Main Window"
msgstr "Main Window"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:42
msgid "Added official GPL-3.0 license file to project root."
msgstr "Added official GPL-3.0 license file to project root."

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:43
msgid "Bumped version number to v0.3.1 across configurations."
msgstr "Bumped version number to v0.3.1 across configurations."

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:50
msgid "SSH Port Forwarding: complete management for local, remote, and dynamic forwarding rules running on dedicated background channels"
msgstr "SSH Port Forwarding: complete management for local, remote, and dynamic forwarding rules running on dedicated background channels"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:51
msgid "Bitwarden config sync: encrypted backup and restoration of connections and keychains using Bitwarden Secure Notes"
msgstr "Bitwarden config sync: encrypted backup and restoration of connections and keychains using Bitwarden Secure Notes"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:52
msgid "Security: added smart log metadata redactor to automatically mask credentials and host addresses in application logs"
msgstr "Security: added smart log metadata redactor to automatically mask credentials and host addresses in application logs"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:53
msgid "Tab context menu: added duplicate tab action and multiple layout styling alignments (Host, Keychain, Port Forwarding)"
msgstr "Tab context menu: added duplicate tab action and multiple layout styling alignments (Host, Keychain, Port Forwarding)"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:54
msgid "CJK support: bundled fallback fonts and enabled wide-character terminal rendering under Flatpak"
msgstr "CJK support: bundled fallback fonts and enabled wide-character terminal rendering under Flatpak"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:55
msgid "Platform: improved multi-arch ARM64 building compatibility and fixed Vte GObject namespace resolution"
msgstr "Platform: improved multi-arch ARM64 building compatibility and fixed Vte GObject namespace resolution"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:62
msgid "SFTP rewrite: clean concurrency model with separate metadata lock and transfer semaphore"
msgstr "SFTP rewrite: clean concurrency model with separate metadata lock and transfer semaphore"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:63
msgid "SFTP edit workflow: rclone copyto downloads file to /tmp for external editor, monitors changes and syncs back"
msgstr "SFTP edit workflow: rclone copyto downloads file to /tmp for external editor, monitors changes and syncs back"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:64
msgid "Rclone: read-write FUSE mount, stderr-based readiness detection, atomic tmpdir cleanup"
msgstr "Rclone: read-write FUSE mount, stderr-based readiness detection, atomic tmpdir cleanup"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:65
msgid "Rclone: implemented cross-host transfer and GLib cache dir for Flatpak compatibility"
msgstr "Rclone: implemented cross-host transfer and GLib cache dir for Flatpak compatibility"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:66
msgid "File browser: fixed row selection bug after sorting, drag-and-drop upload, split new-file/new-folder actions"
msgstr "File browser: fixed row selection bug after sorting, drag-and-drop upload, split new-file/new-folder actions"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:73
msgid "Zen Mode Welcome Page: redesigned home screen for a focused, minimalist experience"
msgstr "Zen Mode Welcome Page: redesigned home screen for a focused, minimalist experience"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:74
msgid "GNOME Light Terminal Theme: new preset matching the Adwaita light palette"
msgstr "GNOME Light Terminal Theme: new preset matching the Adwaita light palette"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:75
msgid "Fixed translation error mislabelling Hostname fields as Username in English locale"
msgstr "Fixed translation error mislabelling Hostname fields as Username in English locale"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:76
msgid "Optimised local PTY resizing and fixed terminal tab closing behaviour"
msgstr "Optimised local PTY resizing and fixed terminal tab closing behaviour"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:83
msgid "Fixed Bitwarden session restoration and login crash (NameError)"
msgstr "Fixed Bitwarden session restoration and login crash (NameError)"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:84
msgid "Improved local vault lockout recovery with a new 'Reset' option in the UI"
msgstr "Improved local vault lockout recovery with a new 'Reset' option in the UI"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:85
msgid "Enhanced 2FA flow and error handling for CLI-managed sessions"
msgstr "Enhanced 2FA flow and error handling for CLI-managed sessions"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:92
msgid "Fixed Bitwarden Vault auto-unlocking logic for Flatpak due to excessive Keyring permission"
msgstr "Fixed Bitwarden Vault auto-unlocking logic for Flatpak due to excessive Keyring permission"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:93
msgid "Fixed language switching and missing i18n .mo files in Flatpak runtime"
msgstr "Fixed language switching and missing i18n .mo files in Flatpak runtime"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:94
msgid "Removed error-prone legacy JSON payload fallback in decryptor"
msgstr "Removed error-prone legacy JSON payload fallback in decryptor"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:101
msgid "Enhanced security: Zero-string copy memory management"
msgstr "Enhanced security: Zero-string copy memory management"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:102
msgid "Refactored Secure Vault with binary packing"
msgstr "Refactored Secure Vault with binary packing"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:103
msgid "Improved terminal keyboard handling and theme consistency"
msgstr "Improved terminal keyboard handling and theme consistency"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:104
msgid "Added German and Traditional Chinese translations"
msgstr "Added German and Traditional Chinese translations"

#: data/io.github.ailing2416.sentinel.metainfo.xml.in:105
msgid "Process-level credential protection improvements"
msgstr "Process-level credential protection improvements"

